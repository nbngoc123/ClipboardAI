<Window x:Class="ClipboardAI.Views.Popups.EditHotkeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Hotkey" Height="250" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="#1F1F1F" Foreground="White"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Press the keys you want to use as a hotkey." FontSize="14" HorizontalAlignment="Center"/>
        
        <Border Grid.Row="1" Background="#2B2B2B" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Margin="0,20">
            <TextBlock x:Name="HotkeyDisplay" Text="Press a key combination..." 
                       VerticalAlignment="Center" HorizontalAlignment="Center" 
                       FontSize="20" FontWeight="Bold" Foreground="#4A90E2"/>
        </Border>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Width="80" Height="30" Margin="0,0,10,0" Background="Transparent" Foreground="White" BorderBrush="#555"/>
            <Button Content="Save" Click="Save_Click" Width="80" Height="30" Background="#0078D7" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
