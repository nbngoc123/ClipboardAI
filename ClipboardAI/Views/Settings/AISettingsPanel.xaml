<UserControl x:Class="ClipboardAI.Views.Settings.AISettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:ClipboardAI.ViewModels.Settings"
             d:DataContext="{d:DesignInstance Type=viewmodels:AISettingsViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="600"
             Background="Transparent">
    
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="✨" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AI Integration" FontSize="24" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Configure Azure OpenAI for Smart Extraction." FontSize="14" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Background="#1A1A1A" CornerRadius="8" Padding="20" Margin="0,20,0,0" BorderBrush="#333333" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Azure OpenAI Endpoint" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#2A2A2A" Foreground="White" BorderBrush="#444444" BorderThickness="1" Padding="8" Margin="0,0,0,16"/>
                             
                    <TextBlock Text="API Key" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                    <PasswordBox x:Name="TokenPasswordBox" PasswordChanged="TokenPasswordBox_PasswordChanged" Loaded="TokenPasswordBox_Loaded"
                                 Background="#2A2A2A" Foreground="White" BorderBrush="#444444" BorderThickness="1" Padding="8" Margin="0,0,0,16"/>
                             
                    <TextBlock Text="Deployment Model Name" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#2A2A2A" Foreground="White" BorderBrush="#444444" BorderThickness="1" Padding="8" Margin="0,0,0,24"/>
                             
                    <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" 
                            Background="#0078D4" Foreground="White" Padding="16,8" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
