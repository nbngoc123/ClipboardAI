<UserControl x:Class="ClipboardAI.Views.Controls.SearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="40">
    <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Height="36">
        <Grid>
            <!-- Search Icon -->
            <TextBlock Text="🔍" Foreground="#666666" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0"/>
            
            <!-- Input Field -->
            <TextBox x:Name="SearchTextBox" 
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                     Background="Transparent"
                     Foreground="White"
                     CaretBrush="White"
                     BorderThickness="0"
                     Padding="36,0,12,0" 
                     VerticalContentAlignment="Center" 
                     FontSize="14"/>
                     
            <!-- Placeholder -->
            <TextBlock IsHitTestVisible="False" 
                       Text="Search history..." 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Left" 
                       Margin="36,0,0,0" 
                       Foreground="#888888"
                       FontSize="14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
