<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ============================================== -->
    <!-- 1. COLOR PALETTE & TYPOGRAPHY -->
    <!-- ============================================== -->
    <SolidColorBrush x:Key="PtAccentBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="PtSurfaceContentBrush" Color="#202020"/> <!-- Content area background -->
    <SolidColorBrush x:Key="PtSurfaceNavBrush" Color="#282828"/>     <!-- Lighter for depth in Sidebar -->
    <SolidColorBrush x:Key="PtCardBrush" Color="#2D2D2D"/>           <!-- Card surface -->
    <SolidColorBrush x:Key="PtHoverBrush" Color="#383838"/>          <!-- Hover background -->
    <SolidColorBrush x:Key="PtBorderBrush" Color="#454545"/>         <!-- 0.5px separator -->
    <SolidColorBrush x:Key="PtTextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PtTextSecondaryBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="PtStatusEnabledBrush" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="PtStatusDisabledBrush" Color="#999999"/>

    <FontFamily x:Key="PtFontFamily">Segoe UI Variable, Segoe UI, System-ui, Sans-serif</FontFamily>

    <!-- Base Typography Styles -->
    <Style x:Key="PtBaseText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PtFontFamily}"/>
        <Setter Property="Foreground" Value="{StaticResource PtTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="PtSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource PtBaseText}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PtTextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,15,0,8"/>
    </Style>

    <!-- ============================================== -->
    <!-- 2. COMPONENT PATTERNS -->
    <!-- ============================================== -->

    <!-- Keyboard Badge (Keycap) -->
    <Style x:Key="PtKeyboardBadge" TargetType="Border">
        <Setter Property="Background" Value="#2D2D2D"/>
        <Setter Property="BorderBrush" Value="#1A1A1A"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
    <Style x:Key="PtKeyboardBadgeText" TargetType="TextBlock" BasedOn="{StaticResource PtBaseText}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Toggle Switch -->
    <Style x:Key="PtToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource PtTextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PtFontFamily}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid VerticalAlignment="Center">
                        <!-- Track -->
                        <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" 
                                Background="Transparent" BorderBrush="{StaticResource PtTextSecondaryBrush}" BorderThickness="1.5">
                            <!-- Thumb -->
                            <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="{StaticResource PtTextSecondaryBrush}" 
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Checked State -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource PtAccentBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource PtAccentBrush}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            <Setter TargetName="Thumb" Property="Width" Value="12"/>
                            <Setter TargetName="Thumb" Property="Height" Value="12"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="4,0,0,0"/>
                            <!-- Move thumb to right -->
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Hover state (Unchecked) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="BorderBrush" Value="#FFFFFF"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                        </MultiTrigger>
                        <!-- Hover state (Checked) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="#0078D4"/> <!-- Brighter blue -->
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section Card -->
    <!-- We use an outer Border to draw the stroke and shadow/background,
         and inner clipping is done implicitly if we don't apply backgrounds to the inner items 
         or if we just use a nested Border with CornerRadius too. -->
    <Style x:Key="PtSectionCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PtCardBrush}"/>
        <Setter Property="BorderBrush" Value="#101010"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,24"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Primary Button (Accent) -->
    <Style x:Key="PtPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PtAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource PtFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#0078D4"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#004A90"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standard Button -->
    <Style x:Key="PtStandardButton" TargetType="Button">
        <Setter Property="Background" Value="#2D2D2D"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource PtFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="BorderBrush" Value="{StaticResource PtBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#383838"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#202020"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text Box -->
    <Style x:Key="PtTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#1F1F1F"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CaretBrush" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource PtBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{StaticResource PtFontFamily}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- Removed custom ControlTemplate to avoid breaking text rendering -->
    </Style>

    <!-- ComboBox Item -->
    <Style x:Key="PtComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="#2D2D2D"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Basic ComboBox Shell -->
    <Style x:Key="PtComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="#1F1F1F"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource PtBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource PtComboBoxItem}"/>
    </Style>

</ResourceDictionary>
